local       f_pay_curSAID_chn   = ProtoField.uint8 ("osp.payload.curSAID.chn"    , "Channel"           , base.HEX)
local       f_pay_curSAID_cur   = ProtoField.uint16("osp.payload.curSAID.cur"    , "Current"           , base.HEX)
local       f_pay_curSAID_free  = ProtoField.uint16("osp.payload.curSAID.rsvd"   , "Reserved"          , base.HEX, nil, 0x8000)
local       f_pay_curSAID_sync  = ProtoField.uint16("osp.payload.curSAID.sync"   , "Sync    "          , base.HEX, nil, 0x4000)

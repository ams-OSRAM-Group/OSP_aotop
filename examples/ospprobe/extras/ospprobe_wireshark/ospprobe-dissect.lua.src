local       f_pay_pwmSAID_rsvd  = ProtoField.uint8 ("osp.payload.pwmSAID.rsvd"   , "Reserved "         , base.HEX)
local       f_pay_pwmSAID_red   = ProtoField.uint16("osp.payload.pwmSAID.red"    , "PWM red  "         , base.HEX)
local       f_pay_pwmSAID_grn   = ProtoField.uint16("osp.payload.pwmSAID.grn"    , "PWM green"         , base.HEX)

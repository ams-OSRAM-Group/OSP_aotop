-- ospprobe-dissect.lua - OSP telegram dissector (for DLT 147)


-- - Store this file in the user's plugins directory
--   PORTABLE64  C:\Programs\WiresharkPortable64\Data\plugins
-- - Wireshark must be told to map DLT 147 to ospprobe
--   - In Wireshark, go to Edit > Preferences.
--   - Expand "Protocols" (in left pane) and scroll down to DLT_USER.
--   - Click Edit... next to "Encapsulations Table".
--   - Click the + (plus) button to add a new entry:
--     - Column DLT: select 147.
--     - Column Payload dissector: type ospprobe


local p_osp = Proto("ospprobe", "OSP telegrams")


-- ----------------------------------------------------------------------------
-- Decoding errors
-- ----------------------------------------------------------------------------
-- Table based on ospprobe\manc.h manc_result_t


local decode_errors = {
  [0] = "ok",                     -- "ok",
  [1] = "first pulse not 0",      -- "wronglevel",
  [2] = "first pulse not short",  -- "expectshort",
  [3] = "wrong pulse length",     -- "wrongduration",
  [4] = "too many pulses",        -- "toomanybytes",
  [5] = "num pulses not 8-fold",  -- "no8fold",
  [6] = "assert in code",         -- "assert"
}


